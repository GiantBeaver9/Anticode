# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your numeric Telegram user ID (get it from @userinfobot).
# Comma-separated if you ever want to allow more than one user.
ALLOWED_USER_IDS=123456789

# OpenAI-compatible endpoint of your local LLM server.
#   LM Studio:     http://localhost:1234/v1   (default)
#   Ollama:        http://localhost:11434/v1
#   llama.cpp:     http://localhost:8080/v1
LLM_BASE_URL=http://localhost:1234/v1

# Model name. Leave empty to auto-detect whatever model is loaded in LM Studio.
LLM_MODEL=

# Most local servers ignore the API key; leave as-is unless yours needs one.
LLM_API_KEY=not-needed

# Optional tuning
SYSTEM_PROMPT=You are a helpful assistant.
MAX_HISTORY_MESSAGES=40
LLM_TIMEOUT_SECONDS=300

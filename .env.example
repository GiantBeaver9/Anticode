# Copy to .env (or set these in your host's environment) before running.

# Password used to log in to the app. Change this before deploying.
APP_PASSWORD=change-me

# Where the SQLite database file lives.
# Defaults to <app>/data/assessment.db next to the server binary.
# DATABASE_PATH=/var/lib/anticode/assessment.db

# Port / bindings for the ASP.NET Core server (optional).
# ASPNETCORE_URLS=http://0.0.0.0:8080
